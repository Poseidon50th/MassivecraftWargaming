{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "massivecraft-wars-multiplayer",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "MatchRoom"
      },
      {
        "name": "ROOM_ADMISSION",
        "class_name": "RoomAdmission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RoomAdmission"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://poseidon50th.github.io,http://localhost:4173,http://127.0.0.1:4173,http://terminal.local:4173",
    "DAILY_ROOM_CREATION_LIMIT": "400",
    "CLIENT_ROOM_CREATION_LIMIT": "8",
    "CLIENT_ROOM_CREATION_WINDOW_MS": "600000"
  },
  "observability": {
    "enabled": true
  }
}
